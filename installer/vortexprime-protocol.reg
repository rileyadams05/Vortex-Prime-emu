Windows Registry Editor Version 5.00

; ============================================================
; Vortex Prime Custom Protocol Handler Registration
; ============================================================
; 
; This script registers the "vortexprime://" custom URI scheme
; to launch Vortex Prime UI.exe when clicked in a browser.
;
; INSTRUCTIONS:
; 1. Edit the path below if your installation directory is different
; 2. Save this file with a .reg extension
; 3. Right-click the file and select "Merge" (requires Admin privileges)
; 4. Click "Yes" on the UAC prompt and confirmation dialog
;
; DEFAULT PATH: C:\Program Files\Vortex Prime\Vortex Prime UI.exe
; ============================================================

[HKEY_CLASSES_ROOT\vortexprime]
@="URL:Vortex Prime Protocol"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\vortexprime\DefaultIcon]
@="\"C:\\Program Files\\Vortex Prime\\Vortex Prime UI.exe\",0"

[HKEY_CLASSES_ROOT\vortexprime\shell]

[HKEY_CLASSES_ROOT\vortexprime\shell\open]

[HKEY_CLASSES_ROOT\vortexprime\shell\open\command]
@="\"C:\\Program Files\\Vortex Prime\\Vortex Prime UI.exe\" \"%1\""

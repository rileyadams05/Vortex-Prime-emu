{
    "productName": "Vortex Prime Emu",
    "version": "1.0.0",
    "identifier": "com.vortex.prime.emu",
    "build": {
        "beforeDevCommand": "node start-dev-servers.js",
        "beforeBuildCommand": "cd frontend && npm run build",
        "devUrl": "http://localhost:3000",
        "frontendDist": "../frontend/build"
    },
    "app": {
        "windows": [
            {
                "title": "Vortex Prime Emu",
                "width": 1280,
                "height": 720,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "alwaysOnTop": false,
                "center": true,
                "minWidth": 1024,
                "minHeight": 600,
                "transparent": false,
                "skipTaskbar": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' http://localhost:3000 http://localhost:3005 http://localhost:8000 https://xbl.io https://login.live.com https://customer-assets.emergentagent.com https://retroachievements.org"
        },
        "trayIcon": {
            "iconPath": "icons/icon.ico",
            "iconAsTemplate": false,
            "menuOnLeftClick": false
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "msi",
            "nsis"
        ],
        "icon": [
            "icons/icon.ico"
        ],
        "resources": [
            "resources/**/*",
            "../runtime/java_env/**/*"
        ],
        "externalBin": [],
        "copyright": "Copyright © 2025 Vortex Prime",
        "category": "Game",
        "shortDescription": "Xbox 360 Dashboard for Vortex Prime Emu",
        "longDescription": "A professional Xbox 360-style dashboard interface for managing and launching Xbox 360 games via the Vortex Prime Emu.",
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": ""
        }
    },
    "plugins": {
        "fs": {
            "requireLiteralLeadingDot": false
        },
        "deep-link": {
            "desktop": {
                "schemes": ["vortexprime"]
            }
        }
    }
}
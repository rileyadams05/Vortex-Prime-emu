# Discord Integration
DISCORD_PUBLIC_KEY="your_discord_public_key_here"

# CORS Settings
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://localhost:3005"
FRONTEND_URL="http://localhost:3005"

# RetroAchievements API Configuration
# Get your API key from: https://retroachievements.org/controlpanel.php
RETROACHIEVEMENTS_API_KEY="your_retroachievements_api_key_here"
RETROACHIEVEMENTS_USERNAME="your_retroachievements_username_here"

# TheMovieDB API Configuration
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY="your_tmdb_api_key_here"
